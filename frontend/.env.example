# =============================================================================
# MARGENX FRONTEND — Variables de Entorno de Ejemplo (Vite)
# Copiar este archivo a .env o .env.local en la carpeta frontend/
# =============================================================================

# URL de la API Backend
VITE_API_URL="http://localhost:3000/api"
# Staging / Producción (VPS, ver infra/vps/README.md):
# VITE_API_URL="https://api-dev.margenx.tech/api"
# VITE_API_URL="https://api.margenx.tech/api"

# Autenticación Clerk (Frontend)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_tu_publishable_key_aqui"

# Minutos de inactividad antes de cerrar la sesión automáticamente, en milisegundos
# (opcional; por defecto 1800000 = 30 minutos — ver src/hooks/useSessionSecurity.ts)
# VITE_INACTIVITY_TIMEOUT_MS=1800000