# =============================================================================
# MARGENX BACKEND — Variables de Entorno de Ejemplo
# Copiar este archivo a .env y ajustar según el entorno.
# =============================================================================

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Base de Datos (PostgreSQL + Prisma)
# -----------------------------------------------------------------------------
# Local (DevContainer Docker):
DATABASE_URL="postgresql://postgres:devpassword123@localhost:5432/margenx_dev?schema=public"
# Producción (VPS):
# DATABASE_URL="postgresql://margenx_admin:PASSWORD@168.197.49.120:5435/margenx_prod?schema=public"

# -----------------------------------------------------------------------------
# Automatización y Webhooks (n8n)
# -----------------------------------------------------------------------------
# Local:
N8N_WEBHOOK_URL="http://localhost:5678/webhook"
N8N_MARGIN_ALERT_WEBHOOK_URL="http://localhost:5678/webhook/margin-alert"
# Secreto compartido backend <-> n8n (header x-margenx-webhook-secret).
# Generar uno largo y aleatorio (ej: openssl rand -hex 32). Si falta, el backend NO despacha alertas (fail-closed).
INTERNAL_WEBHOOK_SECRET="changeme_use_a_real_secret"
# Producción (Dominio seguro con HTTPS):
# N8N_WEBHOOK_URL="https://n8n.margenx.tech/webhook"
# N8N_MARGIN_ALERT_WEBHOOK_URL="https://n8n.margenx.tech/webhook/margin-alert"

# -----------------------------------------------------------------------------
# Autenticación (Clerk JWT)
# -----------------------------------------------------------------------------
CLERK_SECRET_KEY="sk_test_tu_secret_key_aqui"
CLERK_JWT_KEY="tu_clave_publica_jwt_aqui"

SEED_CONFIRM_TARGET=localhost:5432/margenx_dev
