generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                      String    @id @default(uuid())
  businessName            String
  slug                    String    @unique
  subscriptionPlan        String    @default("FREE")
  trialEndsAt             DateTime?
  isActive                Boolean   @default(true)
  defaultMinMarginPercent Decimal   @default(30) @db.Decimal(5, 2)
  createdAt               DateTime  @default(now())

  users       User[]
  ingredients Ingredient[]
  products    Product[]
  suppliers   Supplier[]
}

enum Role {
  ADMIN
  COLLABORATOR
}

model User {
  id             String   @id @default(uuid())
  accountId      String
  email          String   @unique
  role           Role     @default(COLLABORATOR)
  authProviderId String   @unique
  createdAt      DateTime @default(now())
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Ingredient {
  id           String               @id @default(uuid())
  accountId    String
  name         String
  unit         String // kg, l, unit
  currentCost  Decimal              @db.Decimal(10, 2)
  updatedAt    DateTime             @updatedAt
  account      Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  products     ProductIngredient[]
  suppliers    SupplierIngredient[]
  priceHistory PriceHistory[]

  // Índice de acceso por cuenta y nombre.
  // La unicidad case-insensitive por cuenta se garantiza con el índice funcional UNIQUE
  // registrado en la migración SQL: CREATE UNIQUE INDEX "Ingredient_accountId_lower_name_key" ON "Ingredient"("accountId", lower("name"));
  @@index([accountId, name])
}

model Supplier {
  id           String               @id @default(uuid())
  accountId    String
  name         String
  contactPhone String?
  email        String?
  address      String?
  isActive     Boolean              @default(true)
  account      Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ingredients  SupplierIngredient[]

  // Índice de acceso por cuenta y nombre.
  // La unicidad case-insensitive por cuenta se garantiza con el índice funcional UNIQUE
  // registrado en la migración SQL: CREATE UNIQUE INDEX "Supplier_accountId_lower_name_key" ON "Supplier"("accountId", lower("name"));
  @@index([accountId, name])
}

model SupplierIngredient {
  id                  String     @id @default(uuid())
  supplierId          String
  ingredientId        String
  supplierCode        String? // <-- CORRECCIÓN: Ahora es OPCIONAL
  rawDescription      String?
  packageSize         Decimal    @db.Decimal(10, 3)
  packageUnit         String
  packagePrice        Decimal    @db.Decimal(10, 2)
  pendingPackagePrice Decimal?   @db.Decimal(10, 2)
  isDefault           Boolean    @default(false)
  isQuarantined       Boolean    @default(false)
  quarantinedAt       DateTime?
  quarantineReason    String?
  supplier            Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ingredient          Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([supplierId, ingredientId])
  @@unique([supplierId, supplierCode])
}

model PriceHistory {
  id           String     @id @default(uuid())
  ingredientId String
  oldCost      Decimal    @db.Decimal(10, 2)
  newCost      Decimal    @db.Decimal(10, 2)
  changedAt    DateTime   @default(now())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId, changedAt])
}

model Product {
  id               String              @id @default(uuid())
  accountId        String
  name             String
  salePrice        Decimal             @db.Decimal(10, 2)
  minMarginPercent Decimal             @db.Decimal(5, 2)
  updatedAt        DateTime            @updatedAt
  account          Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ingredients      ProductIngredient[]
  cost             Decimal             @default(0) @db.Decimal(10, 2)
  marginAmount     Decimal             @default(0) @db.Decimal(10, 2)
  marginPercent    Decimal             @default(0) @db.Decimal(8, 2)

  // Índice de acceso por cuenta y nombre.
  // La unicidad case-insensitive por cuenta se garantiza con el índice funcional UNIQUE
  // registrado en la migración SQL: CREATE UNIQUE INDEX "Product_accountId_lower_name_key" ON "Product"("accountId", lower("name"));
  @@index([accountId, name])
}

model ProductIngredient {
  id           String     @id @default(uuid())
  productId    String
  ingredientId String
  quantity     Decimal    @db.Decimal(10, 3)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
}
