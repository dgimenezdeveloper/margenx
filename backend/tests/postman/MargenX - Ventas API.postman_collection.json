      "name": "03 - GET /api/sales (ADMIN): listado paginado de la cuenta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK (si es 404, el módulo está apagado: ver README-Ventas.md)', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Contrato { data, meta }', function () {",
              "  pm.expect(body.data).to.be.an('array');",
              "  pm.expect(body.meta).to.include.all.keys('total', 'page', 'limit', 'totalPages');",
              "  pm.expect(body.meta.limit).to.eql(20);",
              "});",
              "pm.test('Cache-Control: private, no-store', function () { pm.expect(pm.response.headers.get('Cache-Control')).to.eql('private, no-store'); });"
            ]
