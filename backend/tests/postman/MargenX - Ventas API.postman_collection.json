{
  "info": {
    "name": "MargenX - Ventas API",
    "description": "Contrato, roles y validaciones de /api/sales (ADR-010, docs/api.md §12). No modifica datos: la cuenta no tiene turno abierto, así que la venta responde 409. Preparación en README-Ventas.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "4b8e2f1a-6c3d-4e5f-9a7b-8c1d2e3f4a5b"
  },
  "item": [
    {
      "name": "01 - GET /api/products (toma un producto con receta de la cuenta)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
              "const productos = pm.response.json().data || [];",
              "const vendible = productos.find(function (p) { return Number(p.salePrice) > 0 && Array.isArray(p.ingredients) && p.ingredients.length > 0; });",
              "pm.test('La cuenta tiene un producto con receta y precio', function () { pm.expect(vendible, 'producto vendible').to.be.an('object'); });",
              "if (vendible) pm.collectionVariables.set('productId', vendible.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products?limit=100",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ],
          "query": [
            {
              "key": "limit",
              "value": "100"
            }
          ]
        }
      },
      "response": []
    },
