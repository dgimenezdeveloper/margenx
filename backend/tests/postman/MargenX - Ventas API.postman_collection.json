              "const shift = pm.response.json().shift;",
              "const cash = shift.methods.find(function (m) { return m.paymentMethod === 'CASH'; });",
              "const expected = (10000 + Number(pm.collectionVariables.get('saleTotal'))).toFixed(2);",
              "pm.test('1 venta, 1 anulada y el efectivo esperado = inicial + la venta válida', function () {",
              "  pm.expect(shift.salesCount).to.eql(1);",
              "  pm.expect(shift.voidedCount).to.eql(1);",
              "  pm.expect(cash.expected).to.eql(expected);",
              "});",
              "pm.collectionVariables.set('countedCash', (Number(cash.expected) - 500).toFixed(2));",
              "pm.test('Sin costos ni márgenes', function () { pm.expect(JSON.stringify(shift)).to.not.match(/cost|margin/i); });"
