    {
      "name": "04 - GET /api/sales (COLLABORATOR): solo sus ventas y sin costos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
              "const texto = JSON.stringify(pm.response.json());",
              "pm.test('Sin costos ni márgenes para el colaborador', function () {",
              "  ['unitCost', 'lineCost', 'marginPercent', 'totalCost'].forEach(function (campo) { pm.expect(texto).to.not.include(campo); });",
              "});"
            ]
          }
        }
