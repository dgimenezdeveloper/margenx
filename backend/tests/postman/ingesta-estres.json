              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const realCodes = { HAR188: 18406.25, HAR187: 21126.22, AZU015: 11400.00, CRE101: 50254.70, GRA013: 77706.20, LEV201: 67245.80, SAL010: 11806.61, 'DR-LECHE01': 1715.00, 'DR-HUEVO01': 5800.00, 'DR-RICOTA01': 23075.00 };",
                  "const bump = 1 + (Number(pm.environment.get('priceBumpPercent') || '3') / 100) + 0.01;",
                  "const items = Object.entries(realCodes).map(([code, price]) => ({ code, description: `Lista de estres ${code}`, price: Math.round(price * bump * 100) / 100 }));",
                  "const garbageCount = 5000 - items.length;",
                  "for (let i = 0; i < garbageCount; i++) items.push({ code: `ESTRES-VOL-${i}`, description: 'Codigo inexistente (volumen)', price: 1 });",
                  "pm.request.body.update(JSON.stringify({ accountSlug: pm.environment.get('validAccountSlug'), items }));"
