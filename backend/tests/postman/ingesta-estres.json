        {
          "name": "Concurrencia: 15 requests simultaneos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Salud previa a la concurrencia: 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "const baseUrl = pm.environment.get('baseUrl');",
                  "const secret = pm.environment.get('internalWebhookSecret');",
                  "const slug = pm.environment.get('validAccountSlug');",
                  "const realCodes = { HAR188: 18406.25, HAR187: 21126.22, AZU015: 11400.00, CRE101: 50254.70, GRA013: 77706.20, LEV201: 67245.80, SAL010: 11806.61 };",
                  "",
                  "function sendOne(i) {",
                  "  const bump = 1 + (0.05 + i * 0.001);",
                  "  const items = Object.entries(realCodes).map(([code, price]) => ({ code, description: `Concurrencia ${i}`, price: Math.round(price * bump * 100) / 100 }));",
                  "  for (let j = 0; j < 293; j++) items.push({ code: `ESTRES-CONC-${i}-${j}`, price: 1 });",
                  "  return new Promise((resolve, reject) => {",
                  "    pm.sendRequest({",
                  "      url: baseUrl + '/webhooks/supplier-prices',",
                  "      method: 'POST',",
                  "      header: { 'Content-Type': 'application/json', 'x-margenx-webhook-secret': secret },",
                  "      body: { mode: 'raw', raw: JSON.stringify({ accountSlug: slug, items }) }",
                  "    }, (err, res) => (err ? reject(err) : resolve(res)));",
                  "  });",
                  "}",
                  "",
                  "return Promise.all(Array.from({ length: 15 }, (_, i) => sendOne(i))).then((responses) => {",
                  "  pm.test('las 15 corridas concurrentes devuelven 200', function () {",
                  "    responses.forEach((r) => pm.expect(r.code).to.eql(200));",
                  "  });",
                  "  pm.test('ninguna corrida concurrente devuelve un error de servidor (5xx)', function () {",
                  "    responses.forEach((r) => pm.expect(r.code).to.be.below(500));",
                  "  });",
                  "  pm.test('las 15 corridas procesan los 7 codigos reales sin perder ninguno', function () {",
                  "    responses.forEach((r) => {",
                  "      const json = r.json();",
                  "      pm.expect(json.updated + json.unchanged + json.quarantined).to.eql(7);",
                  "    });",
                  "  });",
                  "});"
                ]
              }
            }
