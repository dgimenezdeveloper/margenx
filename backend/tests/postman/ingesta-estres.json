    {
      "name": "01 - Escenario de la issue 176 (3000 filas, Gherkin)",
      "item": [
        {
          "name": "Lote de 3000 filas, 95% codigos desconocidos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Los 10 supplierCode reales de Panaderia Central: 7 de MarJuanC + 3 de Don Roque",
                  "// (DR-LECHE01/DR-HUEVO01/DR-RICOTA01 son codigos internos de QA, ver backend/prisma/seed.ts).",
                  "const realCodes = {",
                  "  HAR188: 18406.25,",
                  "  HAR187: 21126.22,",
                  "  AZU015: 11400.00,",
                  "  CRE101: 50254.70,",
                  "  GRA013: 77706.20,",
                  "  LEV201: 67245.80,",
                  "  SAL010: 11806.61,",
                  "  'DR-LECHE01': 1715.00,",
                  "  'DR-HUEVO01': 5800.00,",
                  "  'DR-RICOTA01': 23075.00,",
                  "};",
                  "const bump = 1 + (Number(pm.environment.get('priceBumpPercent') || '3') / 100);",
                  "const items = Object.entries(realCodes).map(([code, price]) => ({",
                  "  code,",
                  "  description: `Lista de estres ${code}`,",
                  "  price: Math.round(price * bump * 100) / 100,",
                  "}));",
                  "// 2990 filas de polucion con caracteres especiales, igual que los ejemplos de la issue.",
                  "const garbagePrefixes = ['ART-9999', 'TORNILLO-3MM', 'LAVANDINA-XYZ', 'CLAVO#2\"', 'ITEM&RARO'];",
                  "for (let i = 0; i < 2990; i++) {",
                  "  const prefix = garbagePrefixes[i % garbagePrefixes.length];",
                  "  items.push({ code: `${prefix}-${i}`, description: 'Codigo inexistente (polucion)', price: 1 });",
                  "}",
                  "pm.request.body.update(JSON.stringify({ accountSlug: pm.environment.get('validAccountSlug'), items }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('tiempo de respuesta bajo 1.5s', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});",
                  "",
                  "pm.test('received es 3000', function () {",
                  "    pm.expect(pm.response.json().received).to.eql(3000);",
                  "});",
                  "",
                  "pm.test('discarded es 2990 (3000 - 10 codigos reales), ningun 500', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.discarded).to.eql(2990);",
                  "});",
                  "",
                  "pm.test('los 10 codigos reales se procesan (updated + unchanged + quarantined = 10)', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.updated + json.unchanged + json.quarantined).to.eql(10);",
                  "});",
                  "",
                  "pm.test('no se insertan registros espurios: discardedCodes son solo los codigos de polucion', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.discardedCodes.length).to.eql(100); // tope de la API",
                  "    pm.expect(json.discardedCodes.every((d) => d.reason === 'NOT_FOUND')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-margenx-webhook-secret", "value": "{{internalWebhookSecret}}" },
              { "key": "Content-Type", "value": "application/json" }
