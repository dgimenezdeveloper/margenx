            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/webhooks/supplier-prices", "host": ["{{baseUrl}}"], "path": ["webhooks", "supplier-prices"] }
          },
          "response": []
