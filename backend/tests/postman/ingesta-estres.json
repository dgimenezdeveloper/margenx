    {
      "name": "01 - Volumen",
      "item": [
        {
          "name": "Lote de 5000 items en el tope del schema",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 7 codigos reales de MarJuanC (Panaderia Central, seed.ts) + relleno NOT_FOUND hasta el tope de 5000 del schema (z.array().max(5000)).",
                  "const realCodes = {",
                  "  HAR188: 18406.25,",
                  "  HAR187: 21126.22,",
                  "  AZU015: 11400.00,",
                  "  CRE101: 50254.70,",
                  "  GRA013: 77706.20,",
                  "  LEV201: 67245.80,",
                  "  SAL010: 11806.61,",
                  "};",
                  "const bump = 1 + (Number(pm.environment.get('priceBumpPercent') || '3') / 100);",
                  "const items = Object.entries(realCodes).map(([code, price]) => ({",
                  "  code,",
                  "  description: `Lista de estres ${code}`,",
                  "  price: Math.round(price * bump * 100) / 100,",
                  "}));",
                  "const garbageCount = 5000 - items.length;",
                  "for (let i = 0; i < garbageCount; i++) {",
                  "  items.push({ code: `ESTRES-VOL-${i}`, description: 'Codigo inexistente (volumen)', price: 1 });",
                  "}",
                  "pm.request.body.update(JSON.stringify({ accountSlug: pm.environment.get('validAccountSlug'), items }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('received es exactamente 5000 (tope del schema)', function () {",
                  "    pm.expect(pm.response.json().received).to.eql(5000);",
                  "});",
                  "",
                  "pm.test('los 7 codigos reales se procesan (updated + unchanged + quarantined = 7)', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.updated + json.unchanged + json.quarantined).to.eql(7);",
                  "});",
                  "",
                  "pm.test('el resto se descarta por NOT_FOUND, con tope de 100 en discardedCodes', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.discarded).to.eql(4993);",
                  "    pm.expect(json.discardedCodes.length).to.eql(100);",
                  "    pm.expect(json.discardedCodes.every((d) => d.reason === 'NOT_FOUND')).to.be.true;",
                  "});",
                  "",
                  "pm.test('no hay duplicados en este lote', function () {",
                  "    pm.expect(pm.response.json().duplicates).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-margenx-webhook-secret", "value": "{{internalWebhookSecret}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
