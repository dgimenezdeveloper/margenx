                  "pm.test('los 10 codigos reales se procesan', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.updated + json.unchanged + json.quarantined).to.eql(10);",
                  "});",
                  "pm.test('el resto se descarta por NOT_FOUND', function () {",
                  "    pm.expect(pm.response.json().discarded).to.eql(4990);",
                  "});"
                ]
