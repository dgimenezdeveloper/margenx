{
  "info": {
    "name": "MargenX - Dashboard API",
    "description": "Pruebas de contrato y RBAC para GET /api/dashboard/metrics: buckets completos del histograma, consistencia con críticos/saludables, margen promedio robusto (mediana) y bloqueo 403 a COLLABORATOR.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "a4d9c1b2-8e73-4f6b-9c2a-1d5e8f3a7b90"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "adminToken", "value": "<jwt-admin>" },
    { "key": "collaboratorToken", "value": "<jwt-colaborador>" }
  ],
  "item": [
    {
      "name": "01 - GET /api/dashboard/metrics sin token (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test('Mensaje uniforme de autenticación', function () {",
              "    pm.expect(pm.response.json().error).to.eql('No autorizado');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/dashboard/metrics",
          "host": ["{{baseUrl}}"],
          "path": ["dashboard", "metrics"]
        }
      },
      "response": []
    },
    {
      "name": "02 - GET /api/dashboard/metrics como COLLABORATOR (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 403 Forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "pm.test('Mensaje RBAC de rol ADMIN requerido', function () {",
              "    pm.expect(pm.response.json().error).to.eql('Acceso denegado. Se requiere rol ADMIN.');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{collaboratorToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/dashboard/metrics",
          "host": ["{{baseUrl}}"],
          "path": ["dashboard", "metrics"]
        }
      },
      "response": []
    },
    {
      "name": "03 - GET /api/dashboard/metrics como ADMIN devuelve buckets completos y mediana (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const schema = {",
              "    type: 'object',",
              "    required: [",
              "        'activeIngredientsCount',",
              "        'criticalProductsCount',",
              "        'healthyProductsCount',",
              "        'averageMarginPercent',",
              "        'recentCostVariationsCount',",
              "        'lossCount',",
              "        'riskCount',",
              "        'targetCount',",
              "        'surplusCount',",
              "        'draftCount'",
              "    ],",
              "    properties: {",
              "        activeIngredientsCount: { type: 'integer', minimum: 0 },",
              "        criticalProductsCount: { type: 'integer', minimum: 0 },",
              "        healthyProductsCount: { type: 'integer', minimum: 0 },",
              "        averageMarginPercent: { type: 'number' },",
              "        recentCostVariationsCount: { type: 'integer', minimum: 0 },",
              "        lossCount: { type: 'integer', minimum: 0 },",
              "        riskCount: { type: 'integer', minimum: 0 },",
              "        targetCount: { type: 'integer', minimum: 0 },",
              "        surplusCount: { type: 'integer', minimum: 0 },",
              "        draftCount: { type: 'integer', minimum: 0 }",
              "    }",
              "};",
              "",
              "pm.test('El payload respeta el schema completo de métricas y buckets', function () {",
              "    pm.response.to.have.jsonSchema(schema);",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('lossCount + riskCount coincide con criticalProductsCount', function () {",
              "    pm.expect(body.lossCount + body.riskCount).to.eql(body.criticalProductsCount);",
              "});",
              "",
              "pm.test('targetCount + surplusCount coincide con healthyProductsCount', function () {",
              "    pm.expect(body.targetCount + body.surplusCount).to.eql(body.healthyProductsCount);",
              "});",
              "",
              "pm.test('averageMarginPercent es finito y no supera 100%', function () {",
              "    pm.expect(Number.isFinite(body.averageMarginPercent)).to.be.true;",
              "    pm.expect(body.averageMarginPercent).to.be.at.most(100);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/dashboard/metrics",
          "host": ["{{baseUrl}}"],
          "path": ["dashboard", "metrics"]
        }
      },
      "response": []
    }
  ]
}
