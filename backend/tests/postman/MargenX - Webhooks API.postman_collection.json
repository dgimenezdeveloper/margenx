    {
      "name": "05 - Rechaza payload > 5000 items",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const items = [];",
              "for (let i = 1; i <= 5001; i++) {",
              "  items.push({",
              "    code: 'SKU-' + i,",
              "    description: 'Producto ' + i,",
              "    price: 10 + i",
              "  });",
              "}",
              "pm.request.body.update(JSON.stringify({ accountSlug: pm.variables.get('validAccountSlug'), items }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Respuesta indica límite de 5000', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.error).to.match(/5000|items|max/i);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-margenx-webhook-secret", "value": "{{internalWebhookSecret}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
