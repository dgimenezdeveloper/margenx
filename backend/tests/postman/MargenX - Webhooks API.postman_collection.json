    {
      "name": "04 - Acepta payload válido para cuenta activa",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Respuesta confirma recepcion del lote (contrato vigente)', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.received).to.eql(100);",
              "    pm.expect(json.updated).to.eql(0);",
              "    pm.expect(json.unchanged).to.eql(0);",
              "    pm.expect(json.quarantined).to.eql(0);",
              "    pm.expect(json.duplicates).to.eql(0);",
              "    pm.expect(json.discarded).to.eql(100);",
              "    pm.expect(json.discardedCodes).to.be.an('array').with.lengthOf(100);",
              "    pm.expect(json.discardedCodes[0]).to.have.all.keys(['code', 'reason']);",
              "    pm.expect(json.discardedCodes[0].reason).to.eql('NOT_FOUND');",
              "    pm.expect(json.account).to.eql({ tradeName: 'Panadería Central', ownerEmail: 'admin.panaderia@seed.example.test' });",
              "    pm.expect(json.criticalProductsAlerts).to.eql([]);",
              "});"
            ]
          }
        }
      ],
