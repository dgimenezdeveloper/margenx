    {
      "name": "03 - Rechaza slug inexistente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 404', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Respuesta indica que la cuenta no existe o está inactiva', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.error).to.include('No existe una cuenta activa para el slug indicado');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-margenx-webhook-secret", "value": "{{internalWebhookSecret}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountSlug\": \"slug-inexistente\",\n  \"items\": [\n    { \"code\": \"SKU-999\", \"description\": \"Producto inexistente\", \"price\": 99.99 }\n  ]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/webhooks/supplier-prices",
          "host": ["{{baseUrl}}"],
          "path": ["webhooks", "supplier-prices"]
        }
      },
      "response": []
