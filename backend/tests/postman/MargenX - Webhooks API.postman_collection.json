{
  "info": {
    "_postman_id": "4e8a43d9-d78b-4f78-a91a-87e0d0e9f9a1",
    "name": "MargenX - Webhooks API",
    "description": "Colección de pruebas para el endpoint de ingestión masiva de precios por webhook. Cubre casos de autorizacion, slug inexistente, payload válido y límite de 5000 items.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Rechaza sin secreto interno",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('Respuesta indica Unauthorized', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.error).to.eql('Unauthorized');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountSlug\": \"{{validAccountSlug}}\",\n  \"items\": [\n    { \"code\": \"SKU-1\", \"description\": \"Producto 1\", \"price\": 123.45 }\n  ]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/webhooks/supplier-prices",
          "host": ["{{baseUrl}}"],
          "path": ["webhooks", "supplier-prices"]
        }
      },
      "response": []
    },
