    {
      "name": "03 - Validaciones del ADMIN (sin efectos en Clerk)",
      "item": [
        {
          "name": "POST /api/auth/invitations - correo inválido da 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ADMIN_TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/invitations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
