        {
          "name": "GET /api/auth/users - lista los usuarios de la cuenta",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ADMIN_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const users = pm.response.json().users;",
                  "pm.test('incluye al ADMIN autenticado', function () { pm.expect(users.map(u => u.id)).to.include(pm.collectionVariables.get('adminUserId')); });",
                  "pm.test('no expone authProviderId', function () { users.forEach(u => pm.expect(u).to.not.have.property('authProviderId')); });",
                  "pm.test('cada usuario trae email, rol y fecha', function () { users.forEach(u => pm.expect(u).to.include.all.keys('id', 'email', 'role', 'createdAt')); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/invitations - lista las pendientes de la cuenta",
          "request": {
            "method": "GET",
            "header": [
