                "invitations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cajera-quimica\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('mensaje de correo inválido', function () { pm.expect(pm.response.json().error).to.eql('Ingresá un correo electrónico válido.'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
