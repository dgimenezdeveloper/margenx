    {
      "name": "09 - POST /api/purchasing/order-preview pedido válido (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Calcula subtotal, total y ahorro exactos para 2 bultos de Harina Molinera', function () {",
              "    pm.expect(body.groups).to.have.lengthOf(1);",
              "    pm.expect(body.totalPackages).to.eql(2);",
              "    pm.expect(body.itemsCount).to.eql(1);",
              "    pm.expect(body.total).to.eql('36000.00');",
              "    pm.expect(body.totalSavings).to.eql('812.50');",
              "    pm.expect(body.groups[0].subtotal).to.eql('36000.00');",
              "    pm.expect(body.groups[0].savings).to.eql('812.50');",
              "});"
            ]
          }
        }
      ],
      "request": {
