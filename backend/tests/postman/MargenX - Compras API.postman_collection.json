{
  "info": {
    "name": "MargenX - Compras API",
    "description": "Pruebas de contrato, RBAC y precisión Decimal para Smart Purchasing: GET /api/purchasing/suggestions y POST /api/purchasing/order-preview.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b7c4d2a1-9f8e-4c6b-8a1d-3e5f7a9c2b10"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "adminToken", "value": "<jwt-admin>" },
    { "key": "collaboratorToken", "value": "<jwt-colaborador>" },
    { "key": "harinaMolineraId", "value": "" },
    { "key": "harinaIngredientId", "value": "30b00001-0000-4000-8000-000000000001" }
  ],
  "item": [
    {
      "name": "01 - GET /api/purchasing/suggestions sin token (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test('Mensaje uniforme de autenticación', function () {",
              "    pm.expect(pm.response.json().error).to.eql('No autorizado');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/purchasing/suggestions",
          "host": ["{{baseUrl}}"],
          "path": ["purchasing", "suggestions"]
        }
      },
      "response": []
    },
    {
      "name": "02 - GET /api/purchasing/suggestions como COLLABORATOR (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 403 Forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "pm.test('Mensaje RBAC de rol ADMIN requerido', function () {",
              "    pm.expect(pm.response.json().error).to.eql('Acceso denegado. Se requiere rol ADMIN.');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{collaboratorToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/purchasing/suggestions",
          "host": ["{{baseUrl}}"],
          "path": ["purchasing", "suggestions"]
        }
      },
      "response": []
    },
    {
      "name": "03 - GET /api/purchasing/suggestions como ADMIN (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Contiene estructura completa de sugerencias y resumen', function () {",
              "    pm.expect(body).to.have.all.keys([",
              "        'summary',",
              "        'byIngredient',",
              "        'bySupplier',",
              "        'alreadyBestPrice',",
              "        'singleSupplier',",
              "        'quarantinedExcluded'",
              "    ]);",
              "    pm.expect(body.summary).to.include.all.keys([",
              "        'withSavingsCount',",
              "        'alreadyBestPriceCount',",
              "        'singleSupplierCount',",
              "        'withoutEligibleSupplierCount',",
              "        'withoutActiveDefaultCount',",
              "        'quarantinedExcludedCount'",
              "    ]);",
              "});",
              "const harinaItem = body.byIngredient.find(i => i.ingredientId === pm.collectionVariables.get('harinaIngredientId'));",
              "pm.test('Harina 000 del seed muestra ahorro con Distribuidora Mayorista Molinera', function () {",
              "    pm.expect(harinaItem).to.exist;",
              "    pm.expect(harinaItem.defaultPresentation.unitCost).to.eql('736.25');",
              "    pm.expect(harinaItem.cheapestPresentation.unitCost).to.eql('720.00');",
              "    pm.expect(harinaItem.savingsPerUnit).to.eql('16.25');",
              "    pm.expect(harinaItem.savingsPercent).to.eql('2.21');",
              "    pm.expect(harinaItem.packageSavings).to.eql('406.25');",
              "});",
              "pm.collectionVariables.set('harinaMolineraId', harinaItem.cheapestPresentation.supplierIngredientId);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/purchasing/suggestions",
          "host": ["{{baseUrl}}"],
          "path": ["purchasing", "suggestions"]
        }
      },
      "response": []
    },
    {
      "name": "04 - GET /api/ingredients/:id confirma que el costo vigente no cambió (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('El costo vigente de Harina 000 sigue en 736.25', function () {",
              "    pm.expect(pm.response.json().ingredient.currentCost).to.eql('736.25');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/ingredients/{{harinaIngredientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["ingredients", "{{harinaIngredientId}}"]
        }
      },
      "response": []
    },
