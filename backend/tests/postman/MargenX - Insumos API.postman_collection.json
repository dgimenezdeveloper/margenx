        {
          "name": "PUT Validación - bloquear cambio de unidad en insumo con uso (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test('El mensaje indica cuántas recetas y presentaciones usan el insumo', function () {",
                  "    const error = pm.response.json().error;",
                  "    pm.expect(error).to.match(/^No se puede cambiar la unidad: el insumo está en \\d+ receta\\(s\\) y \\d+ presentación\\(es\\) de proveedor\\./);",
                  "});",
                  "",
                  "pm.sendRequest({",
                  "    url: pm.variables.get('baseUrl') + '/ingredients/30b00001-0000-4000-8000-000000000001',",
                  "    method: 'GET',",
                  "    header: { Authorization: 'Bearer ' + pm.environment.get('token_cuenta_A') }",
                  "}, function (err, res) {",
                  "    pm.test('La unidad del insumo no fue modificada (sigue en kg)', function () {",
                  "        pm.expect(err).to.eql(null);",
                  "        pm.expect(res.code).to.eql(200);",
                  "        pm.expect(res.json().ingredient.unit).to.eql('kg');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_cuenta_A}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Harina de trigo 000 Olavarriense\",\n  \"unit\": \"l\",\n  \"currentCost\": \"736.25\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/ingredients/30b00001-0000-4000-8000-000000000001",
              "host": ["{{baseUrl}}"],
              "path": ["ingredients", "30b00001-0000-4000-8000-000000000001"]
            }
          },
          "response": []
        },
        {
          "name": "PUT Aviso - costo manual distinto de la presentación predeterminada (409, #427)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// #427: Harina 000 tiene la presentación predeterminada HAR188. Un costo manual que no coincide con el de esa",
                  "// presentación, sin elegir defaultPresentationAction, responde 409 y no guarda nada.",
                  "pm.test('Status code es 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test('Devuelve DEFAULT_PRESENTATION_MISMATCH con los datos de la presentación predeterminada', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql('DEFAULT_PRESENTATION_MISMATCH');",
                  "    pm.expect(body.defaultPresentation.supplierName).to.be.a('string').and.not.empty;",
                  "    pm.expect(Number(body.defaultPresentation.unitCost)).to.be.above(1);",
                  "    pm.expect(body.defaultPresentation.packageUnit).to.eql('kg');",
                  "});",
                  "",
                  "pm.sendRequest({",
                  "    url: pm.variables.get('baseUrl') + '/ingredients/30b00001-0000-4000-8000-000000000001',",
                  "    method: 'GET',",
                  "    header: { Authorization: 'Bearer ' + pm.environment.get('token_cuenta_A') }",
                  "}, function (err, res) {",
                  "    pm.test('El costo del insumo no fue modificado', function () {",
                  "        pm.expect(err).to.eql(null);",
                  "        pm.expect(res.code).to.eql(200);",
                  "        pm.expect(Number(res.json().ingredient.currentCost)).to.not.eql(1);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_cuenta_A}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Harina de trigo 000 Olavarriense\",\n  \"unit\": \"kg\",\n  \"currentCost\": \"1.00\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/ingredients/30b00001-0000-4000-8000-000000000001",
              "host": ["{{baseUrl}}"],
              "path": ["ingredients", "30b00001-0000-4000-8000-000000000001"]
            }
          },
          "response": []
        },
        {
          "name": "PUT Actualizar la presentación con un precio del bulto fuera de rango (422, #427)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// #427: la bolsa de 25 kg de HAR188 a $4.000.000/kg daría $100.000.000, que no entra en el precio del bulto",
                  "// (máximo $99.999.999,99). Con \"update-presentation\" responde 422 antes de guardar nada.",
                  "pm.test('Status code es 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test('El mensaje explica el límite del precio del bulto', function () {",
                  "    pm.expect(pm.response.json().error).to.include('El precio del bulto no puede superar $99.999.999,99');",
                  "});",
                  "",
                  "pm.sendRequest({",
                  "    url: pm.variables.get('baseUrl') + '/ingredients/30b00001-0000-4000-8000-000000000001',",
                  "    method: 'GET',",
                  "    header: { Authorization: 'Bearer ' + pm.environment.get('token_cuenta_A') }",
                  "}, function (err, res) {",
                  "    pm.test('El costo del insumo no fue modificado', function () {",
                  "        pm.expect(err).to.eql(null);",
                  "        pm.expect(res.code).to.eql(200);",
                  "        pm.expect(Number(res.json().ingredient.currentCost)).to.not.eql(4000000);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_cuenta_A}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Harina de trigo 000 Olavarriense\",\n  \"unit\": \"kg\",\n  \"currentCost\": \"4000000\",\n  \"defaultPresentationAction\": \"update-presentation\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/ingredients/30b00001-0000-4000-8000-000000000001",
              "host": ["{{baseUrl}}"],
              "path": ["ingredients", "30b00001-0000-4000-8000-000000000001"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Aislamiento Multiempresa (Cuenta B contra datos de Cuenta A)",
      "item": [
        {
          "name": "GET Insumo ajeno (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 404 Not Found (nunca 403, ni 200)', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
