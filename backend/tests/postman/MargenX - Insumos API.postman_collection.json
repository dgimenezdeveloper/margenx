        {
          "name": "GET Listar insumos (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Contrato paginado desde la issue #36: { data: [...], meta: { total,",
                  "// page, limit, totalPages } }. Si el contrato de este endpoint vuelve a",
                  "// cambiar, actualizar este schema en el mismo PR (regla de",
                  "// docs/process/revision-de-prs.md).",
                  "",
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const schema = {",
                  "    type: 'object',",
                  "    required: ['data', 'meta'],",
                  "    properties: {",
                  "        data: {",
                  "            type: 'array',",
                  "            items: {",
                  "                type: 'object',",
                  "                required: ['id', 'accountId', 'name', 'unit', 'currentCost', 'updatedAt']",
                  "            }",
                  "        },",
                  "        meta: {",
                  "            type: 'object',",
                  "            required: ['total', 'page', 'limit', 'totalPages']",
                  "        }",
                  "    }",
                  "};",
                  "",
                  "pm.test('El body respeta el schema paginado vigente (issue #36)', function () {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test('El insumo creado en este run aparece en el listado de su cuenta', function () {",
                  "    const ids = pm.response.json().data.map((i) => i.id);",
                  "    pm.expect(ids).to.include(pm.environment.get('ingredientId_cuentaA'));",
                  "});"
                ]
              }
            }
          ],
