        {
          "name": "GET Productos que usan Harina 000 del seed (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Devuelve productos paginados con nombre, cantidad y estado de margen', function () {",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.data.length).to.be.at.least(1);",
                  "    pm.expect(json.meta.total).to.be.at.least(1);",
                  "    json.data.forEach((p) => {",
                  "        pm.expect(p).to.include.all.keys('id', 'name', 'quantity', 'salePrice', 'cost', 'marginPercent', 'minMarginPercent', 'marginStatus');",
                  "        pm.expect(['loss', 'risk', 'target', 'surplus']).to.include(p.marginStatus);",
                  "    });",
                  "});"
                ]
              }
            }
