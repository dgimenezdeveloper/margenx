{
  "info": {
    "name": "MargenX - Alertas de margen (Insumos)",
    "description": "Casos de validación del contrato PUT /api/ingredients/:id para alertas de margen. Cubre cambio real, no-op, acceso no autorizado y conteo total vs críticos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "8c1e8b6a-4fbe-4d4d-9f1d-6cbe1f4cbb7d"
  },
  "item": [
    {
      "name": "00 - Guarda el insumo como estaba antes de la corrida",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Guarda nombre, unidad y costo de antes de la corrida: 04 los vuelve a dejar así (#312).",
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const ingrediente = pm.response.json().ingredient;",
              "pm.collectionVariables.set('harinaNombreOriginal', ingrediente.name);",
              "pm.collectionVariables.set('harinaUnidadOriginal', ingrediente.unit);",
              "pm.collectionVariables.set('harinaCostoOriginal', String(ingrediente.currentCost));",
              "pm.test('El costo de partida no es el 9500 que fija 01: así 01 y 04 son cambios reales', function () {",
              "  pm.expect(Number(ingrediente.currentCost)).to.not.eql(9500);",
              "});",
              "// Con presentación predeterminada, 01 y 04 eligen \"update-presentation\" (ADR-011): el bulto sigue al costo y 05",
              "// controla que vuelva a dar el costo de antes de la corrida.",
              "const predeterminada = (ingrediente.suppliers || []).find(function (p) { return p.isDefault; });",
              "pm.collectionVariables.set('harinaPresentacionId', predeterminada ? predeterminada.id : '');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/ingredients/{{ingredientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["ingredients", "{{ingredientId}}"]
        }
      },
      "response": []
    },
    {
      "name": "01 - Cambio real: affectedProductsCount total + criticalProducts subset",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// La Harina tiene presentación predeterminada: sin elegir qué hacer con ella, el PUT respondería 409 (ADR-011).",
              "// \"update-presentation\" lleva el bulto a 9500/kg, y 04 lo vuelve al costo de antes de la corrida.",
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('El payload expone affectedProductsCount total', function () {",
              "  pm.expect(body.affectedProductsCount).to.be.a('number');",
              "  pm.expect(body.affectedProductsCount).to.be.greaterThan(0);",
              "});",
              "pm.test('criticalProducts contiene solo los críticos', function () {",
              "  pm.expect(body.criticalProducts).to.be.an('array');",
              "  pm.expect(body.criticalProducts.length).to.be.at.most(body.affectedProductsCount);",
              "});",
              "pm.test('La respuesta tiene la forma que consume el frontend', function () {",
              "  pm.expect(body).to.have.property('ingredient');",
              "  pm.expect(body).to.have.property('affectedProductsCount');",
              "  pm.expect(body).to.have.property('criticalProducts');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{harinaNombreOriginal}}\",\n  \"unit\": \"{{harinaUnidadOriginal}}\",\n  \"currentCost\": \"9500.00\",\n  \"defaultPresentationAction\": \"update-presentation\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ingredients/{{ingredientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["ingredients", "{{ingredientId}}"]
        }
      },
      "response": []
    },
    {
      "name": "02 - Sin cambio real: affectedProductsCount = 0 y criticalProducts = []",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Reenvía el mismo currentCost que dejó el request 01 (9500.00), no el",
              "// costo de antes de la corrida: este request comparte el insumo con el",
              "// 01 dentro de la misma corrida, así que \"sin cambio real\" tiene que",
              "// probarse contra el valor vigente en este momento, no contra la base.",
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('No hubo cambio real', function () {",
              "  pm.expect(body.affectedProductsCount).to.eql(0);",
              "  pm.expect(body.criticalProducts).to.eql([]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{harinaNombreOriginal}}\",\n  \"unit\": \"{{harinaUnidadOriginal}}\",\n  \"currentCost\": \"9500.00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ingredients/{{ingredientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["ingredients", "{{ingredientId}}"]
        }
      },
      "response": []
    },
    {
      "name": "03 - Colaborador: 403 Forbidden",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Mensaje real de backend/src/middlewares/rbac.ts:52 (requireRole).",
              "pm.test('Status 403', function () { pm.response.to.have.status(403); });",
              "pm.test('Se bloquea la mutación por RBAC', function () {",
              "  pm.expect(pm.response.json().error).to.eql('Acceso denegado. Se requiere rol ADMIN.');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{collaboratorToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{harinaNombreOriginal}}\",\n  \"unit\": \"{{harinaUnidadOriginal}}\",\n  \"currentCost\": \"9500.00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ingredients/{{ingredientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["ingredients", "{{ingredientId}}"]
        }
      },
      "response": []
    },
    {
      "name": "04 - Alert dispatch: payload enviado por n8n usa el total real y la lista crítica",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Vuelve el insumo al costo, nombre y unidad que tenía antes de la corrida (los guarda 00,",
              "// y 05 controla que queden iguales). Es un cambio real otra vez (desde 9500), así que",
              "// prueba el envío de la alerta y de paso deja la colección repetible sin limpieza aparte (#312).",
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('El total real queda en affectedProductsCount', function () {",
              "  pm.expect(body.affectedProductsCount).to.be.a('number');",
              "  pm.expect(body.affectedProductsCount).to.be.greaterThan(0);",
              "});",
              "pm.test('La lista crítica es un subconjunto del total', function () {",
              "  pm.expect(body.criticalProducts.length).to.be.at.most(body.affectedProductsCount);",
              "});",
              "// La respuesta también incluye affectedProducts (la lista completa,",
              "// no solo el total): backend/src/routes/ingredients.ts:302-313.",
              "pm.test('La respuesta sigue el contrato esperado por el frontend', function () {",
              "  pm.expect(body).to.have.all.keys(['ingredient', 'affectedProductsCount', 'affectedProducts', 'criticalProducts']);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{harinaNombreOriginal}}\",\n  \"unit\": \"{{harinaUnidadOriginal}}\",\n  \"currentCost\": \"{{harinaCostoOriginal}}\",\n  \"defaultPresentationAction\": \"update-presentation\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ingredients/{{ingredientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["ingredients", "{{ingredientId}}"]
        }
      },
      "response": []
    },
    {
      "name": "05 - El insumo quedó como estaba antes de la corrida",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Control final (#312): la corrida deja el insumo igual que antes de empezar.",
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const ingrediente = pm.response.json().ingredient;",
              "pm.test('El costo vuelve al de antes de la corrida', function () {",
              "  pm.expect(Number(ingrediente.currentCost)).to.eql(Number(pm.collectionVariables.get('harinaCostoOriginal')));",
              "});",
              "pm.test('El nombre y la unidad no cambian', function () {",
              "  pm.expect(ingrediente.name).to.eql(pm.collectionVariables.get('harinaNombreOriginal'));",
              "  pm.expect(ingrediente.unit).to.eql(pm.collectionVariables.get('harinaUnidadOriginal'));",
              "});",
              "const presentacionId = pm.collectionVariables.get('harinaPresentacionId');",
              "if (presentacionId) {",
              "  pm.test('La presentación predeterminada sigue siéndolo y su bulto da el costo de antes de la corrida (ADR-011)', function () {",
              "    const presentacion = (ingrediente.suppliers || []).find(function (p) { return p.id === presentacionId; });",
              "    pm.expect(presentacion, 'la presentación predeterminada que guardó 00').to.be.an('object');",
              "    pm.expect(presentacion.isDefault).to.eql(true);",
              "    const esperado = Math.round(Number(pm.collectionVariables.get('harinaCostoOriginal')) * Number(presentacion.packageSize) * 100) / 100;",
              "    pm.expect(Number(presentacion.packagePrice)).to.eql(esperado);",
              "  });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/ingredients/{{ingredientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["ingredients", "{{ingredientId}}"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "adminToken", "value": "<jwt-admin>" },
    { "key": "collaboratorToken", "value": "<jwt-colaborador>" },
    { "key": "ingredientId", "value": "30b00001-0000-4000-8000-000000000001" }
  ]
}
