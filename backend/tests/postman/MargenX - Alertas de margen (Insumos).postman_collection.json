{
  "info": {
    "name": "MargenX - Alertas de margen (Insumos)",
    "description": "Casos de validación del contrato PUT /api/ingredients/:id para alertas de margen. Cubre cambio real, no-op, acceso no autorizado y conteo total vs críticos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "8c1e8b6a-4fbe-4d4d-9f1d-6cbe1f4cbb7d"
  },
  "item": [
    {
      "name": "01 - Cambio real: affectedProductsCount total + criticalProducts subset",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('El payload expone affectedProductsCount total', function () {",
              "  pm.expect(body.affectedProductsCount).to.be.a('number');",
              "  pm.expect(body.affectedProductsCount).to.be.greaterThan(0);",
              "});",
              "pm.test('criticalProducts contiene solo los críticos', function () {",
              "  pm.expect(body.criticalProducts).to.be.an('array');",
              "  pm.expect(body.criticalProducts.length).to.be.at.most(body.affectedProductsCount);",
              "});",
              "pm.test('La respuesta tiene la forma que consume el frontend', function () {",
              "  pm.expect(body).to.have.property('ingredient');",
              "  pm.expect(body).to.have.property('affectedProductsCount');",
              "  pm.expect(body).to.have.property('criticalProducts');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Harina de trigo 000 Olavarriense\",\n  \"unit\": \"kg\",\n  \"currentCost\": \"9500.00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ingredients/{{ingredientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["ingredients", "{{ingredientId}}"]
        }
      },
      "response": []
    },
    {
      "name": "02 - Sin cambio real: affectedProductsCount = 0 y criticalProducts = []",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Reenvía el mismo currentCost que dejó el request 01 (9500.00), no el",
              "// costo base original (742.98): este request comparte el insumo con el",
              "// 01 dentro de la misma corrida, así que \"sin cambio real\" tiene que",
              "// probarse contra el valor vigente en este momento, no contra la base.",
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('No hubo cambio real', function () {",
              "  pm.expect(body.affectedProductsCount).to.eql(0);",
              "  pm.expect(body.criticalProducts).to.eql([]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Harina de trigo 000 Olavarriense\",\n  \"unit\": \"kg\",\n  \"currentCost\": \"9500.00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ingredients/{{ingredientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["ingredients", "{{ingredientId}}"]
        }
      },
      "response": []
    },
    {
      "name": "03 - Colaborador: 403 Forbidden",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Mensaje real de backend/src/middlewares/rbac.ts:52 (requireRole).",
              "pm.test('Status 403', function () { pm.response.to.have.status(403); });",
              "pm.test('Se bloquea la mutación por RBAC', function () {",
              "  pm.expect(pm.response.json().error).to.eql('Acceso denegado. Se requiere rol ADMIN.');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{collaboratorToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Harina de trigo 000 Olavarriense\",\n  \"unit\": \"kg\",\n  \"currentCost\": \"9500.00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ingredients/{{ingredientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["ingredients", "{{ingredientId}}"]
        }
      },
      "response": []
    },
    {
      "name": "04 - Alert dispatch: payload enviado por n8n usa el total real y la lista crítica",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Vuelve el costo a la base del seed (742.98): es un cambio real otra",
              "// vez (esta vez hacia abajo), así que de paso deja la colección",
              "// reproducible sin una limpieza aparte y sin pisar el baseline que",
              "// usan otras colecciones y las suites E2E.",
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('El total real queda en affectedProductsCount', function () {",
              "  pm.expect(body.affectedProductsCount).to.be.a('number');",
              "  pm.expect(body.affectedProductsCount).to.be.greaterThan(0);",
              "});",
              "pm.test('La lista crítica es un subconjunto del total', function () {",
              "  pm.expect(body.criticalProducts.length).to.be.at.most(body.affectedProductsCount);",
              "});",
              "// La respuesta también incluye affectedProducts (la lista completa,",
              "// no solo el total): backend/src/routes/ingredients.ts:302-313.",
              "pm.test('La respuesta sigue el contrato esperado por el frontend', function () {",
              "  pm.expect(body).to.have.all.keys(['ingredient', 'affectedProductsCount', 'affectedProducts', 'criticalProducts']);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Harina de trigo 000 Olavarriense\",\n  \"unit\": \"kg\",\n  \"currentCost\": \"742.98\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ingredients/{{ingredientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["ingredients", "{{ingredientId}}"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "adminToken", "value": "<jwt-admin>" },
    { "key": "collaboratorToken", "value": "<jwt-colaborador>" },
    { "key": "ingredientId", "value": "30b00001-0000-4000-8000-000000000001" }
  ]
}
