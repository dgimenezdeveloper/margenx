# =============================================================================
# MARGENX — NGINX HOST REVERSE PROXY (PRODUCCIÓN)
# Dominios: margenx.tech & api.margenx.tech
# Ubicación en VPS Donweb: /etc/nginx/sites-available/margenx-prod.conf
# Puertos Docker Host: Frontend 3010 | Backend 3011
# =============================================================================

# --- 1. Frontend Producción (margenx.tech) ---
server {
    listen 80;
    listen [::]:80;
    server_name margenx.tech www.margenx.tech;

    # Redirección permanente a HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name margenx.tech www.margenx.tech;

    # Certificados Let's Encrypt
    ssl_certificate /etc/letsencrypt/live/margenx.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/margenx.tech/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Cabeceras de seguridad
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# --- 2. Backend API Producción (api.margenx.tech) ---
server {
    listen 80;
    listen [::]:80;
    server_name api.margenx.tech;

    # Redirección permanente a HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.margenx.tech;

    # Certificados Let's Encrypt
    ssl_certificate /etc/letsencrypt/live/api.margenx.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.margenx.tech/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:3011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}