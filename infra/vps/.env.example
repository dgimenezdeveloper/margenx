# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=margenx_admin
POSTGRES_PASSWORD=changeme_use_a_real_secret
POSTGRES_DB_PROD=margenx_prod
POSTGRES_DB_DEV=margenx_dev

# ── n8n ──────────────────────────────────────────────────────
N8N_HOST=n8n.margenx.tech
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.margenx.tech/
N8N_MARGIN_ALERT_WEBHOOK_URL=https://n8n.margenx.tech/webhook/margin-alert
# Secreto compartido backend <-> n8n. Un único .env alimenta a n8n y a los dos backends (prod y dev): se rota en un solo lugar.
# Generar con: openssl rand -hex 32. NUNCA commitear el valor real.
INTERNAL_WEBHOOK_SECRET=changeme_use_a_real_secret
N8N_ENCRYPTION_KEY=changeme_use_a_real_secret
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires

# ── Docker Hub ───────────────────────────────────────────────
DOCKER_USERNAME=dgimenezdeveloper

# Los puertos internos (Postgres 5435, n8n 5678, backend/frontend prod y dev)
# están fijos en infra/vps/docker-compose.prod.yml, no son variables de entorno
# — ver infra/vps/README.md §7 y §9 para el valor real de cada uno.

# ==========================================
# CLERK AUTHENTICATION
# ==========================================
# Prod y dev comparten UNA sola instancia de Clerk (claves sk_test_, instancia de desarrollo): ambos backends leen este mismo .env.
# La separación entre entornos está en las bases (margenx_prod / margenx_dev), no en la autenticación.
# Separar claves por entorno (CLERK_SECRET_KEY_PROD / _DEV con override por servicio) requiere una instancia de producción de Clerk: deuda post-freeze.
CLERK_SECRET_KEY=sk_test_tu_clave_secreta_aqui
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----
TU_CLAVE_PUBLICA_PEM_AQUI
-----END PUBLIC KEY-----"

# URL base del backend al que n8n despacha las listas de precios (api-dev.margenx.tech en staging)
MARGENX_API_URL=https://api.margenx.tech

# Credenciales IMAP para Ingesta Automatizada de Listas (n8n)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=margenx.saas@gmail.com
IMAP_PASSWORD=tu_app_password_de_google_aqui
IMAP_SECURE=true

# Webhook del canal de Discord de INFRA (alertas técnicas): monitor-memory.sh y n8n (401/403 al despachar listas).
# Opcional: si falta, solo se omite la alerta. NO es el canal de CI.
DISCORD_WEBHOOK_URL=
# Webhook del canal de notificaciones de CI/PR (lo usa el workflow de GitHub Actions; puede no estar en la VPS).
DISCORD_ALERT_WEBHOOK_URL=