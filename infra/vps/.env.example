# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=margenx_admin
POSTGRES_PASSWORD=changeme_use_a_real_secret
POSTGRES_DB=margenx_prod
POSTGRES_DB_PROD=margenx_prod
POSTGRES_DB_DEV=margenx_dev
# Puerto expuesto del contenedor de Postgres en el host (bindeado a 127.0.0.1)
POSTGRES_PORT=5435

# ── n8n ──────────────────────────────────────────────────────
N8N_HOST=n8n.margenx.tech
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.margenx.tech/
N8N_MARGIN_ALERT_WEBHOOK_URL=https://n8n.margenx.tech/webhook/margin-alert
# Secreto compartido backend <-> n8n. Debe coincidir en .env.prod, .env.dev y en este .env (lo toma n8n).
# Generar con: openssl rand -hex 32. NUNCA commitear el valor real.
INTERNAL_WEBHOOK_SECRET=changeme_use_a_real_secret
N8N_ENCRYPTION_KEY=changeme_use_a_real_secret
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires

# ── Docker Hub ───────────────────────────────────────────────
DOCKER_USERNAME=dgimenezdeveloper

# ── Puertos internos de la aplicación (bindeados a 127.0.0.1, detrás de Nginx) ──
BACKEND_PROD_PORT=3001
FRONTEND_PROD_PORT=8081
BACKEND_DEV_PORT=3002
FRONTEND_DEV_PORT=8082

# ==========================================
# CLERK AUTHENTICATION
# ==========================================
CLERK_SECRET_KEY=sk_test_tu_clave_secreta_aqui
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----
TU_CLAVE_PUBLICA_PEM_AQUI
-----END PUBLIC KEY-----"

# URL base del backend al que n8n despacha las listas de precios (api-dev.margenx.tech en staging)
MARGENX_API_URL=https://api.margenx.tech

# Credenciales IMAP para Ingesta Automatizada de Listas (n8n)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=margenx.saas@gmail.com
IMAP_PASSWORD=tu_app_password_de_google_aqui
IMAP_SECURE=true